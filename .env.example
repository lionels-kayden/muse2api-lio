# ==========================================
# Ví dụ biến môi trường cấu hình MUSE2API
# Sao chép thành .env là có hiệu lực: cp .env.example .env
# ==========================================

# [Bắt buộc/Tùy chọn] Khóa xác thực quản trị và API (bắt đầu bằng m2a_).
# Nếu để trống, khi khởi động lần đầu chương trình sẽ tự động tạo một khóa ngẫu nhiên có độ mạnh cao và in ra log console.
MUSE2API_KEY=m2a_your_secret_admin_key_here

# Địa chỉ và cổng dịch vụ lắng nghe (trong container Docker cần đặt thành 0.0.0.0)
MUSE2API_HOST=0.0.0.0
MUSE2API_PORT=18610

# Địa chỉ truy cập công khai bên ngoài (dùng cho client phía dưới kết nối và trang quản trị ghép nối, ví dụ https://api.yourdomain.com)
# Khi để trống, trang quản trị sẽ tự động dùng host và cổng mà trình duyệt hiện tại đang truy cập
MUSE2API_PUBLIC_BASE=

# Đường dẫn tệp thực thi trình duyệt Chromium
# Trên Linux/Docker thường là /usr/bin/chromium hoặc /usr/bin/chromium-browser
# Khi chạy cục bộ trên Windows có thể đặt thành đường dẫn đầy đủ của Chrome hoặc để trống để tự động tìm
MUSE2API_CHROMIUM=/usr/bin/chromium

# Cổng giao tiếp gỡ lỗi từ xa CDP
MUSE2API_CDP_PORT=19210

# Kiểm soát thời gian chờ tác vụ (đơn vị: giây)
MUSE2API_IMAGE_TIMEOUT=240
MUSE2API_VIDEO_TIMEOUT=600
MUSE2API_CHAT_TIMEOUT=300

# Số tác vụ tạo đồng thời tối đa (hỗ trợ tăng tùy ý theo tài nguyên máy chủ, mặc định 2)
MUSE2API_CONCURRENCY=2

# Có thực hiện tự động giữ kết nối (keepalive) cho tài khoản bị vô hiệu hóa ở nền hay không (0=tắt, 1=bật)
# Sau khi bật, tài khoản đã bị vô hiệu hóa vẫn sẽ thực hiện keepalive âm thầm và gia hạn phiên, nhưng sẽ không được định tuyến tham gia tạo và hội thoại bình thường
MUSE2API_KEEPALIVE_DISABLED_ACCOUNTS=0
